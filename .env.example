# Platform: telegram
PLATFORM=telegram

# OneBot WS mode: forward | reverse
# forward  = adapter listens as WS server; bot framework connects in
# reverse  = adapter connects out to bot framework's WS server
ONEBOT_MODE=reverse

# Shared auth (optional). Sent/verified as Authorization: Bearer <token>
ONEBOT_ACCESS_TOKEN=

# --- forward mode ---
ONEBOT_WS_HOST=0.0.0.0
ONEBOT_WS_PORT=6700
ONEBOT_WS_PATH=/

# --- reverse mode ---
ONEBOT_WS_URL=ws://127.0.0.1:8080/onebot/v11/ws
ONEBOT_RECONNECT_INTERVAL_MS=5000
ONEBOT_HEARTBEAT_INTERVAL_MS=5000

# --- telegram ---
TELEGRAM_TOKEN=
TELEGRAM_API_ROOT=https://api.telegram.org
TELEGRAM_PROXY=
TELEGRAM_POLLING_TIMEOUT_S=25
